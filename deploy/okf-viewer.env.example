# Copy to deploy/okf-viewer.env (git-ignored) and adjust.
# Comma-separated name=path list of OKF bundles to serve.
OKF_BUNDLES=oss-kb=/Users/you/dev/oss-kb
OKF_PORT=4747
OKF_HOST=127.0.0.1

# Public hostname served through the Cloudflare tunnel.
OKF_HOSTNAME=okf.example.com
OKF_TUNNEL_NAME=okf-viewer

# Defense in depth: verify the Cloudflare Access JWT on every request.
# Team domain from Zero Trust > Settings; AUD tag from the Access application.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=you@example.com
